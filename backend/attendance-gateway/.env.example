# Shell variables override this file; backend/.env supplies shared defaults.
BACKEND_URL=http://127.0.0.1:4000
# Required: the school UUID. No school is selected implicitly.
SCHOOL_ID=
# Falls back to GATEWAY_SECRET in backend/.env; it must match the backend.
# GATEWAY_SECRET=
DEVICE_IP=192.168.2.201
DEVICE_PORT=4370
DEVICE_TIME_ZONE=Asia/Tehran
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3002
# Diagnostic APIs are disabled until a token is configured (minimum 16 chars).
# GATEWAY_API_TOKEN=
# Use a separate durable directory for each gateway/device; do not delete it.
# GATEWAY_DATA_DIR=/absolute/path/to/gateway-data
