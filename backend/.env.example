NODE_ENV=development
# App
PORT=4000
HOST=0.0.0.0

# Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maktabi
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
PASSWORD_PEPPER=replace-with-at-least-32-random-characters

# Allowd Clinet To Use Backend
CLIENT_ORIGIN=http://localhost:5173

# Initial super admin (used by src/seed.ts)
SUPER_ADMIN_USERNAME=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
